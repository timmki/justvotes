# Local development settings. Copy to bootstrap/dev.env (ignored by Git) and adjust the values.

# Administrator account; the hash below is the BCrypt hash of the password "password".
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD_HASH=$2a$10$VRCSQc7MNWnuWO1SslINP.m6g9hEb0fLk8TLmTYgq2gl3QvDaGeWK
DATABASE_URL=jdbc:sqlite:./data/justvotes.db

# Invitation mail; without MAIL_HOST invitations are rejected with invitation-delivery-unavailable.
PUBLIC_BASE_URL=http://localhost:5173
MAIL_HOST=smtp.example.test
MAIL_PORT=587
MAIL_USERNAME=mailer@example.test
MAIL_PASSWORD=change-me
MAIL_STARTTLS=true
MAIL_FROM=mailer@example.test
