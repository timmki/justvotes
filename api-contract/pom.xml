<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.justvotes</groupId>
        <artifactId>justvotes</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>api-contract</artifactId>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.12.0</version>
                <executions>
                    <execution>
                        <id>generate-server-contract</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/openapi/justvotes-v1.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <library>spring-boot</library>
                            <apiPackage>de.justvotes.api.v1.server</apiPackage>
                            <modelPackage>de.justvotes.api.v1.model</modelPackage>
                            <configOptions>
                                <validateSpec>true</validateSpec>
                                <interfaceOnly>true</interfaceOnly>
                                <skipDefaultInterface>true</skipDefaultInterface>
                                <requestMappingMode>api_interface</requestMappingMode>
                                <useBeanValidation>true</useBeanValidation>
                                <useSpringBuiltInValidation>false</useSpringBuiltInValidation>
                                <useSpringBoot3>true</useSpringBoot3>
                                <documentationProvider>none</documentationProvider>
                                <openApiNullable>false</openApiNullable>
                                <useResponseEntity>true</useResponseEntity>
                                <useTags>true</useTags>
                                <useOneOfInterfaces>false</useOneOfInterfaces>
                            </configOptions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>generate-typescript-client</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/openapi/justvotes-v1.yaml</inputSpec>
                            <generatorName>typescript-fetch</generatorName>
                            <output>${project.build.directory}/generated-sources/typescript</output>
                            <configOptions>
                                <validateSpec>true</validateSpec>
                                <supportsES6>true</supportsES6>
                                <typescriptThreePlus>true</typescriptThreePlus>
                                <enumPropertyNaming>original</enumPropertyNaming>
                                <useSingleRequestParameter>true</useSingleRequestParameter>
                                <npmName>@justvotes/api-client</npmName>
                                <npmVersion>1.0.0</npmVersion>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
